// Production-Ready Tour Booking Platform Schema
// Supports: Multi-role users, Tours, Bookings, Reviews, Payments, Notifications
// Last Updated: May 12, 2026

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ================================
// ENUMS
// ================================

enum UserRole {
  customer
  supplier
  admin
  expedition
}

enum SupplierStatus {
  PENDING         // Initial application submitted
  UNDER_REVIEW    // Admin reviewing application
  APPROVED        // Admin approved
  ACTIVE          // Fully verified and can receive payouts
  SUSPENDED       // Temporarily suspended
  REJECTED        // Application rejected
}

enum PayoutStatus {
  PENDING         // Booking confirmed, awaiting finance approval
  APPROVED        // Finance approved, queued for payment
  PROCESSING      // Payment initiated
  PAID            // Funds sent to supplier
  FAILED          // Payment failed
  CANCELLED       // Payout cancelled
}

enum PayoutMethodType {
  BANK_TRANSFER
  PAYPAL
}

enum BookingSource {
  TRAVIO
  EXPEDITION
}

enum BookingFlow {
  DIRECT    // Booked on Expedition Go (EG's own supplier tours)
  EXTERNAL  // Redirected to TravioAfrica (other suppliers)
}

enum BookingStatus {
  PENDING         // Payment processing
  CONFIRMED       // Payment successful
  CANCELLED       // Cancelled by customer
  REFUNDED        // Refunded
  COMPLETED       // Tour completed
  NO_SHOW         // Customer didn't show up
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_RECEIVED
  REVIEW_RECEIVED
  SUPPLIER_APPROVED
  SUPPLIER_REJECTED
  PAYOUT_PROCESSED
  PAYOUT_APPROVED
  SYSTEM_ALERT
  NEW_MESSAGE
  TOUR_SUBMITTED
  TOUR_APPROVED
  TOUR_FLAGGED
}

enum AdminNotificationType {
  NEW_SUPPLIER_APPLICATION
  SUPPLIER_STATUS_CHANGE
  REVIEW_NEEDS_MODERATION
  PAYOUT_NEEDS_APPROVAL
  SYSTEM_ALERT
  NEW_MESSAGE
  TOUR_SUBMITTED_FOR_REVIEW
  BOOKING_CREATED
  BOOKING_CONFIRMED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum TourStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  PAUSED
  ARCHIVED
}

enum SpecialOfferType {
  LIMITED_TIME
  EARLY_BIRD
  LAST_MINUTE
}

enum SpecialOfferCapacityType {
  UNLIMITED
  CAPPED
}

enum SpecialOfferTimeSlotMode {
  ALL_DAYS
  SPECIFIC_WEEKDAYS
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum OverrideStatus {
  AVAILABLE
  LIMITED
  FULL
  BLOCKED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum KeywordRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MediaStatus {
  PENDING
  ATTACHED
  ORPHANED
}

model Media {
  id        String      @id @default(cuid())
  url       String      @unique
  publicId  String?
  userId    String?
  status    MediaStatus @default(PENDING)
  entity    String?
  entityId  String?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([url])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ================================
// CORE MODELS
// ================================

model User {
  id           String     @id @default(cuid())
  firebaseUid  String?    @unique
  name         String
  email        String     @unique
  passwordHash String?
  authProvider String     @default("local")
  refreshToken String?
  photoURL     String     @default("")
  logoUrl      String?
  phone        String?
  roles        UserRole[] @default([customer])
  
  // Stripe Integration
  stripeCustomerId String? @unique
  
  // Profile & Preferences
  wishlist     String[]
  likes        String[]
  language     String    @default("en")
  timezone     String    @default("UTC")
  
  // Notification Preferences (JSON object with email/push categories)
  notificationPreferences Json?
  
  // Account Status
  active       Boolean   @default(true)
  emailVerified Boolean  @default(false)
  lastLoginAt  DateTime?
  
  // Admin Role (only for admins — determines granular permissions)
  adminRoleId    String?
  adminRole      AdminRole?    @relation(fields: [adminRoleId], references: [id])
  
  // Supplier Information (only for suppliers)
  supplierProfile SupplierProfile?
  
  // Relationships
  tours        Tour[]
  bookings     Booking[]
  payouts      Payout[]
  payoutMethods PayoutMethod[]
  reviews      Review[]
  notifications Notification[]
  cartItems    CartItem[]
  teamMembers  TeamMember[]     @relation("SupplierTeam")
  teamInvitations TeamMember[]  @relation("TeamInviter")
  chatParticipants ConversationParticipant[]
  messages     Message[]
  specialOffers SpecialOffer[]
  expeditionTours ExpeditionTour[]
  publishedExpeditionTours ExpeditionTour[] @relation("ExpeditionPublishedBy")
  unpublishedExpeditionTours ExpeditionTour[] @relation("ExpeditionUnpublishedBy")
  articles      Article[]
  keywordRequests KeywordRequest[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([roles], type: Gin)      // GIN for array column performance
  @@index([email])
  @@index([createdAt])
  @@index([stripeCustomerId])
}

model SupplierProfile {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Status & Verification
  status       SupplierStatus @default(PENDING)
  
  // Business Information
  businessInfo Json          // Structured business details
  operatingInfo Json         // Operating information
  representativeInfo Json    // Representative details
  businessDocuments Json     // Document URLs
  payoutInfo   Json          // Payout preferences
  compliance   Json          // Terms acceptance & verification
  
  // Admin Review
  adminNotes   String?
  reviewedBy   String?       // Admin user ID
  reviewedAt   DateTime?

  // Archive/Restore (soft-delete lifecycle)
  // JSON: { "archivedAt": ISO string, "tourIds": string[] } — captures exactly
  // which tours the archive action hid, so restore reactivates only those.
  archiveSnapshot Json?
  
  // Statistics
  totalEarnings Decimal      @default(0) @db.Decimal(10,2)
  totalBookings Int          @default(0)
  averageRating Decimal?     @db.Decimal(3,2)
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model PayoutMethod {
  id             String            @id @default(cuid())
  supplierId     String
  supplier       User              @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  type           PayoutMethodType
  isDefault      Boolean           @default(false)
  currency       String            @default("USD")

  // Bank Transfer fields
  bankName       String?
  bankAddress    String?
  bankCountry    String?              // ISO 3166-1 alpha-2, e.g. GH, NG, US
  accountName    String?
  accountNumber  String?
  routingNumber  String?              // ABA routing (US)
  swiftCode      String?              // SWIFT/BIC (international)
  iban           String?              // International Bank Account Number
  sortCode       String?              // Sort code (UK, Ghana, etc.)
  branchCode     String?              // Branch/bank code (Nigeria, etc.)

  // Mobile Money fields
  mobileProvider String?           // e.g. "MTN", "Orange", "Airtel", "Vodafone"
  mobileNumber   String?

  // PayPal fields
  paypalEmail    String?

  // Status
  verified       Boolean           @default(false)

  payouts        Payout[]          // Payouts that used this method

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([supplierId])
}

model Tour {
  id           String      @id @default(cuid())
  supplierId   String
  supplier     User        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  
  // Basic Information
  title        String
  description  String
  referenceCode String?
  photos       String[]
  coverPhoto   String?
  status       TourStatus  @default(DRAFT)

  // Review / Moderation (submit-for-review workflow)
  submittedAt  DateTime?   // When supplier last submitted for review
  reviewedBy   String?     // Admin user ID who made the last review decision
  reviewedAt   DateTime?   // When the last review decision was made
  reviewNote   String?     // Admin note shown to the supplier when flagged

  // Draft / Edit-approval (live-tour edits wait here; the live version keeps selling)
  draftContent     Json?      // Full edited product snapshot (live columns stay untouched)
  draftStatus      String?    // DRAFT | PENDING_APPROVAL | REJECTED
  draftSubmittedAt DateTime?
  draftReviewedAt  DateTime?
  draftReviewNote  String?    // Admin note for a rejected draft

  // Categorization (JSON structure as per your model)
  categorization Json
  theme        Json
  
  // Product Content
  productContent Json
  
  // Schedules & Pricing
  schedulesAndPricing Json
  
  // Booking & Tickets
  bookingAndTickets Json
  
  // SEO & Marketing
  slug         String      @unique
  metaTitle    String?
  metaDescription String?
  tags         String[]
  
  // Location (PostGIS coordinates)
  latitude     Float?      // Used with PostGIS ST_DWithin for geo-search
  longitude    Float?      // Used with PostGIS ST_DWithin for geo-search
  city         String?     // Extracted from productContent.location.city for indexed filtering
  country      String?     // Extracted from productContent.location.country for indexed filtering
  region       String?     // Extracted from productContent.location.region for indexed filtering

  // Normalized categorization (extracted from categorization JSON for indexed filtering)
  category     String?     // e.g. "Adventure", "Cultural", "Nature"
  subcategory  String?     // e.g. "Walking Tours", "Hiking"
  activityType String?     // e.g. "Guided Tour", "Self-Guided"
  difficulty   String?     // e.g. "Easy", "Moderate", "Challenging", "Expert"
  durationMinutes Int?    // Extracted from categorization.duration (hours*60 or days*1440)

  // Normalized theme (extracted from theme JSON)
  primaryTheme String?     // e.g. "Nature & Wildlife", "History & Culture"

  // PostGIS geography column — managed via raw SQL, not by Prisma
  // (trigger function update_tour_location() populates it from lat/lng)
  location_geom Unsupported("geography(Point, 4326)")?

  // Statistics
  totalBookings Int        @default(0)
  totalRevenue Decimal     @default(0) @db.Decimal(10,2)
  averageRating Decimal?   @db.Decimal(3,2)
  reviewCount  Int         @default(0)
  viewCount    Int         @default(0)
  
  // Relationships
  bookings     Booking[]
  reviews      Review[]
  cartItems    CartItem[]
  dateOverrides TourDateOverride[]
  secondaryThemes TourSecondaryTheme[]
  specialOfferTargets SpecialOfferTarget[]
  expeditionTour      ExpeditionTour?
  articles            ArticleTour[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([supplierId])
  @@index([supplierId, status])                  // Supplier dashboard: my tours by status
  @@index([status])
  @@index([status, submittedAt])                 // Admin moderation queue ordering
  @@index([slug])
  @@index([createdAt])
  @@index([averageRating])
  @@index([city])
  @@index([country])
  @@index([region])
  @@index([country, city])
  @@index([category])
  @@index([subcategory])
  @@index([activityType])
  @@index([difficulty])
  @@index([primaryTheme])
  @@index([durationMinutes])
}

model TourDateOverride {
  id                 String         @id @default(cuid())
  tourId             String
  tour               Tour           @relation(fields: [tourId], references: [id], onDelete: Cascade)
  date               DateTime       @db.Date
  status             OverrideStatus @default(AVAILABLE)
  capacity           Int?
  timeSlotOverrides  Json?          // [{ time: "09:00", capacity: 10, booked: 0 }, ...]
  notes              String?

  @@unique([tourId, date])
  @@index([tourId, date])
}

model TourSecondaryTheme {
  id     String @id @default(cuid())
  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  theme  String

  @@unique([tourId, theme])
  @@index([theme])
  @@index([tourId])
}

model SpecialOffer {
  id                 String                     @id @default(cuid())
  supplierId         String
  supplier           User                       @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  name               String
  offerType          SpecialOfferType
  discountType       DiscountType               @default(PERCENTAGE)
  discountPercentage Int                        @default(10)
  fixedDiscountValue Float?
  startDate          DateTime?
  endDate            DateTime?
  isActive           Boolean                    @default(true)

  capacityType       SpecialOfferCapacityType   @default(UNLIMITED)
  maxSpots           Int?
  spotsSold          Int                        @default(0)

  timeSlotMode       SpecialOfferTimeSlotMode   @default(ALL_DAYS)
  specificWeekdays   String[]                   @default([])

  earlyBirdAdvanceDays   Int?
  lastMinuteWindowHours  Int?

  promoCode                String?  @unique
  minQuantity              Int?
  minSpendAmount           Float?
  maxRedemptionsPerCustomer Int?
  stackable                Boolean  @default(false)

  targets            SpecialOfferTarget[]
  bookings           Booking[]

  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([supplierId])
  @@index([isActive, startDate, endDate])
  @@index([offerType])
}

model SpecialOfferTarget {
  id              String       @id @default(cuid())
  specialOfferId  String
  specialOffer    SpecialOffer @relation(fields: [specialOfferId], references: [id], onDelete: Cascade)

  tourId          String
  tour            Tour         @relation(fields: [tourId], references: [id], onDelete: Cascade)

  tourOptionKey   String?
  tourOptionLabel String?

  @@index([tourId])
  @@index([tourOptionKey])
  @@unique([specialOfferId, tourId, tourOptionKey])
}

model Booking {
  id           String        @id @default(cuid())
  bookingNumber String       @unique // Human-readable booking reference
  
  // Relationships
  customerId   String
  customer     User          @relation(fields: [customerId], references: [id])
  tourId       String
  tour         Tour          @relation(fields: [tourId], references: [id])
  
  // Booking Details
  source       BookingSource @default(TRAVIO)
  status       BookingStatus @default(PENDING)
  travelers    Json          // Traveler information
  selectedDate DateTime
  selectedTime String?
  
  // Pricing
  subtotal     Decimal       @db.Decimal(10,2)
  taxes        Decimal       @default(0) @db.Decimal(10,2)
  fees         Decimal       @default(0) @db.Decimal(10,2)
  discounts    Decimal       @default(0) @db.Decimal(10,2)
  total        Decimal       @db.Decimal(10,2)
  currency     String        @default("USD")
  
  // Commission & Payouts
  commissionRate Decimal     @db.Decimal(5,4) // e.g., 0.1500 for 15%
  commissionAmount Decimal   @db.Decimal(10,2)
  supplierPayout Decimal     @db.Decimal(10,2)
  
  // Payment Information
  stripePaymentIntentId String?
  paymentStatus PaymentStatus @default(PENDING)
  paidAt       DateTime?
  
  // Cancellation
  cancellationReason String?
  cancelledAt  DateTime?
  refundAmount Decimal?      @db.Decimal(10,2)
  refundedAt   DateTime?
  
  // Communication
  specialRequests String?
  supplierNotes String?
  
  // Applied special offer (if any)
  appliedOfferId String?
  appliedOffer   SpecialOffer? @relation(fields: [appliedOfferId], references: [id], onDelete: SetNull)
  
  // Relationships
  review       Review?
  payouts      Payout[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([customerId])
  @@index([tourId])
  @@index([status])
  @@index([selectedDate])
  @@index([bookingNumber])
  @@index([stripePaymentIntentId])
  @@index([tourId, status, selectedDate])       // Capacity checks + supplier booking lookup
  @@index([customerId, status, selectedDate])   // "My bookings" filtered pages
  @@index([status, selectedDate])               // Admin/supplier date-range queries
}

model Payout {
  id             String       @id @default(cuid())
  
  // Who gets paid
  supplierId     String
  supplier       User         @relation(fields: [supplierId], references: [id])
  
  // What booking this payout is for
  bookingId      String
  booking        Booking      @relation(fields: [bookingId], references: [id])
  
  // Amounts
  amount         Decimal      @db.Decimal(10,2)
  currency       String       @default("USD")
  commissionAmount Decimal    @db.Decimal(10,2)
  
  // Status
  status         PayoutStatus @default(PENDING)
  
  // Finance processing
  approvedAt     DateTime?
  approvedBy     String?      // Admin user ID who approved
  processedAt    DateTime?
  processedBy    String?      // Admin user ID who processed
  paidAt         DateTime?
  
  // The specific payout method used (linked record)
  payoutMethodId String?
  payoutMethod   PayoutMethod? @relation(fields: [payoutMethodId], references: [id])

  // Payment details
  paymentMethod  String?      // "bank_transfer", "mobile_money", "stripe"
  reference      String?      // Transaction reference from payment provider
  notes          String?      // Admin notes

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@index([supplierId, status])
  @@index([supplierId, createdAt])
  @@index([bookingId])
  @@index([payoutMethodId])
}

model Review {
  id           String      @id @default(cuid())
  
  // Relationships
  bookingId    String?
  booking      Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customerId   String
  customer     User        @relation(fields: [customerId], references: [id])
  tourId       String
  tour         Tour        @relation(fields: [tourId], references: [id])
  
  // Review Content
  rating       Int         // 1-5 stars
  title        String?
  comment      String?
  photos       String[]    // Review photos
  
  // Sub-ratings
  valueForMoneyRating Int?
  guideRating         Int?
  meetingRating       Int?
  
  // Travel metadata
  travelMonth  String?
  companions   String[]
  
  // Moderation
  status       ReviewStatus @default(PENDING)
  moderatedBy  String?     // Admin user ID
  moderatedAt  DateTime?
  flagReason   String?
  
  // Supplier Response
  supplierResponse String?
  supplierResponseAt DateTime?
  
  // Verified Badge
  verified     Boolean     @default(true) // True = booking ownership verified
  
  // Helpfulness
  helpfulCount Int         @default(0)
  reportCount  Int         @default(0)
  
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([bookingId])
  @@index([tourId])
  @@index([customerId])
  @@index([rating])
  @@index([status])
  @@index([createdAt])
  @@index([tourId, status, rating])              // Tour page: approved reviews sorted by rating
  @@index([status, createdAt])                   // Moderation queue
}

model CartItem {
  id           String      @id @default(cuid())
  
  // Relationships
  customerId   String
  customer     User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tourId       String
  tour         Tour        @relation(fields: [tourId], references: [id], onDelete: Cascade)
  
  // Selection Details
  selectedDate DateTime
  selectedTime String?
  travelers    Json        // Traveler count and details
  
  // Pricing (calculated at time of adding to cart)
  subtotal     Decimal     @db.Decimal(10,2)
  total        Decimal     @db.Decimal(10,2)
  currency     String      @default("USD")
  discounts    Decimal     @default(0) @db.Decimal(10,2)
  appliedOfferId String?
  
  // Cart Management
  expiresAt    DateTime    // Cart items expire after X hours
  
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([customerId, tourId, selectedDate, selectedTime])
  @@index([customerId])
  @@index([expiresAt])
}

// ================================
// CHAT MODELS
// ================================

enum ConversationType {
  SUPPLIER_ADMIN
  SUPPLIER_CUSTOMER
  USER_SUPPORT
  EXPEDITION_CUSTOMER
}

model Conversation {
  id           String               @id @default(cuid())
  type         ConversationType     @default(SUPPLIER_ADMIN)
  title        String?              // Auto-generated for 1-on-1: other participant's name
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())

  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  attachmentUrl  String?       // Cloudinary URL
  attachmentType String?       // "image" | "document"
  editedAt       DateTime?
  createdAt      DateTime      @default(now())

  conversation  Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender        User          @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model Notification {
  id           String           @id @default(cuid())
  
  // Relationships
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Notification Content
  type         NotificationType
  title        String
  message      String
  data         Json?            // Additional structured data
  
  // Status
  read         Boolean          @default(false)
  readAt       DateTime?
  
  // Delivery
  emailSent    Boolean          @default(false)
  emailSentAt  DateTime?
  pushSent     Boolean          @default(false)
  pushSentAt   DateTime?
  
  createdAt    DateTime         @default(now())

  @@index([userId])
  @@index([type])
  @@index([read])
  @@index([createdAt])
}

model AdminNotification {
  id           String               @id @default(cuid())
  
  // Notification Content
  type         AdminNotificationType
  title        String
  message      String
  data         Json?                // Additional structured data (supplierId, reviewId, payoutId, etc.)
  
  // Status
  acknowledged Boolean              @default(false)
  acknowledgedAt DateTime?
  acknowledgedBy String?            // Admin user ID who acknowledged
  
  createdAt    DateTime             @default(now())

  @@index([type])
  @@index([acknowledged])
  @@index([createdAt])
}

// ================================
// SYSTEM MODELS
// ================================

model StripeEvent {
  id           String      @id @default(cuid())
  stripeEventId String     @unique
  eventType    String
  processed    Boolean     @default(false)
  data         Json
  
  createdAt    DateTime    @default(now())

  @@index([stripeEventId])
  @@index([processed])
  @@index([eventType])
}

model SystemConfig {
  id           String      @id @default(cuid())
  key          String      @unique
  value        Json
  description  String?
  
  updatedAt    DateTime    @updatedAt
  updatedBy    String      // Admin user ID

  @@index([key])
}

// ================================
// ADMIN SETTINGS — RBAC & CONFIGURATION
// ================================

model AdminPermission {
  id           String   @id @default(cuid())
  key          String   @unique   // e.g. "suppliers.approve", "payouts.view"
  name         String              // e.g. "Approve Suppliers"
  description  String?
  category     String              // e.g. "Suppliers", "Finance", "Reviews"
  isSystem     Boolean  @default(false) // cannot be deleted

  roles        AdminRolePermission[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([key])
}

model AdminRole {
  id           String   @id @default(cuid())
  name         String   @unique    // e.g. "super_admin", "finance_admin"
  description  String?
  isSystem     Boolean  @default(false) // super_admin cannot be deleted or modified
  isDefault    Boolean  @default(false) // auto-assigned to new admins if not specified

  permissions  AdminRolePermission[]
  users        User[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
}

model AdminRolePermission {
  roleId       String
  permissionId String

  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// ================================
// ANALYTICS MODELS
// ================================

model Event {
  id           String   @id @default(cuid())

  name         String   // Dot-notation event name — "booking.completed", "tour.viewed", "search.executed"
  userId       String?  // Authenticated user who triggered the event
  sessionId    String?  // Anonymous session for unauthenticated tracking

  resource     String?  // Affected entity type — "Booking", "Tour", "Review", "User"
  resourceId   String?  // Affected entity ID

  properties   Json     // Arbitrary event payload (query params, tour IDs, amounts, etc.)
  source       String?  // Where the event originated — "web", "mobile", "api", "webhook"

  createdAt    DateTime @default(now())

  @@index([name])
  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@index([name, createdAt])         // Coverage for time-series analytics queries
  @@index([userId, name, createdAt]) // Coverage for user-journey / funnel queries
}

// ================================
// TEAM MANAGEMENT
// ================================

model TeamMember {
  id             String     @id @default(cuid())
  supplierId     String
  supplier       User       @relation("SupplierTeam", fields: [supplierId], references: [id], onDelete: Cascade)
  email          String
  role           String     @default("editor")
  status         String     @default("PENDING")
  invitedById    String?
  invitedBy      User?      @relation("TeamInviter", fields: [invitedById], references: [id])
  inviteToken    String?    @unique
  tokenExpiresAt DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([supplierId, email])
  @@index([supplierId])
  @@index([email])
  @@index([inviteToken])
}

// ================================
// EXPEDITION GO TOUR — CURATED LISTINGS
// ================================

model ExpeditionTour {
  id              String        @id @default(cuid())
  tourId          String        @unique
  tour            Tour          @relation(fields: [tourId], references: [id], onDelete: Cascade)

  // Listing state
  isActive        Boolean       @default(false)
  bookingFlow     BookingFlow   @default(DIRECT)
  externalUrl     String?

  // Display
  displayOrder    Int           @default(0)
  isFeatured      Boolean       @default(false)

  // Audit — publish
  publishedById   String?
  publishedBy     User?         @relation("ExpeditionPublishedBy", fields: [publishedById], references: [id])
  publishedAt     DateTime?

  // Audit — unpublish
  unpublishedById String?
  unpublishedBy   User?         @relation("ExpeditionUnpublishedBy", fields: [unpublishedById], references: [id])
  unpublishedAt   DateTime?
  unpublishReason String?

  // Sync tracking
  syncStatus      String?       // synced | pending | failed
  lastSyncAt      DateTime?
  syncError       String?

  // Legacy adder tracker
  addedById       String?
  addedBy         User?         @relation(fields: [addedById], references: [id], onDelete: SetNull)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([isActive, displayOrder])
  @@index([isActive, isFeatured, displayOrder])
}

// ================================
// BLOG / CMS MODELS
// ================================

model Article {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String        @db.Text
  body            Json          // Portable Text (structured JSON from Sanity)
  featuredImage   String?
  images          Json?
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  publishedAt     DateTime?
  status          ArticleStatus @default(DRAFT)
  readTime        Int?
  locale          String        @default("en")
  viewCount       Int           @default(0)
  shareCount      Int           @default(0)

  authorId        String
  author          User          @relation(fields: [authorId], references: [id])
  categoryId      String?
  category        ArticleCategory? @relation(fields: [categoryId], references: [id])
  tags            ArticleTagOnArticle[]
  relatedTours    ArticleTour[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([locale])
  @@index([authorId])
  @@index([categoryId])
  @@index([status, publishedAt])
  @@index([locale, status, publishedAt])
}

model ArticleCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  parentId    String?
  parent      ArticleCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    ArticleCategory[] @relation("CategoryHierarchy")
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([parentId])
}

model ArticleTag {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  articles  ArticleTagOnArticle[]

  @@index([slug])
}

model ArticleTagOnArticle {
  articleId String
  tagId     String
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       ArticleTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([articleId])
  @@index([tagId])
}

model ArticleTour {
  articleId String
  tourId    String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tour      Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@id([articleId, tourId])
  @@index([articleId])
  @@index([tourId])
}

model AuditLog {
  id           String      @id @default(cuid())
  
  // Actor
  userId       String?
  userEmail    String?
  ipAddress    String?
  userAgent    String?
  
  // Action
  action       String      // e.g., "user.created", "booking.cancelled"
  resource     String      // e.g., "User", "Booking"
  resourceId   String?
  
  // Details
  oldValues    Json?
  newValues    Json?
  metadata     Json?

  // Tamper evidence (hash chain)
  prevHash     String?
  hash         String?
  
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@index([hash])
}

model AuditLogArchive {
  id           String      @id @default(cuid())
  
  // Actor
  userId       String?
  userEmail    String?
  ipAddress    String?
  userAgent    String?
  
  // Action
  action       String
  resource     String
  resourceId   String?
  
  // Details
  oldValues    Json?
  newValues    Json?
  metadata     Json?

  // Tamper evidence (hash chain)
  prevHash     String?
  hash         String?
  
  createdAt    DateTime
  archivedAt   DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([archivedAt])
  @@index([createdAt])
}

model BookingCounter {
  prefix String
  year   Int
  count  Int    @default(0)

  @@id([prefix, year])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String   @default("EXPEDITION")
  subscribed Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([subscribed])
}

model KeywordRequest {
  id          String               @id @default(cuid())
  keyword     String
  supplierId  String
  supplier    User                 @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status      KeywordRequestStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([keyword])
}
