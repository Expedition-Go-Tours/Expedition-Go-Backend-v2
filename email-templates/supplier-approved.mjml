<mjml version="3.3.0">
  <mj-head>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif" line-height="1.6" />
      <mj-text font-size="15px" color="#475569" padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
    <mj-style>
      .hero-img {
        border-radius: 12px !important;
      }
      @media (prefers-color-scheme: dark) {
        .d-bg { background-color: #0f172a !important; }
        .d-card { background-color: #1e293b !important; }
        .d-warm { background-color: #1a1a2e !important; }
        .d-steps { background-color: #16213e !important; }
        .d-text { color: #f1f5f9 !important; }
        .d-muted { color: #94a3b8 !important; }
        .d-cta { background-color: #0c4a3e !important; }
        .d-footer { background-color: #0f172a !important; }
        .d-badge { background-color: #134e4a !important; }
        .d-circle { background-color: #134e4a !important; color: #6ee7b7 !important; }
        .d-step-title { color: #e2e8f0 !important; }
        .d-step-desc { color: #94a3b8 !important; }
        .d-underline { border-bottom-color: #059669 !important; }
      }
      [data-ogsc] .d-bg, [data-ogsb] .d-bg { background-color: #0f172a !important; }
      [data-ogsc] .d-card, [data-ogsb] .d-card { background-color: #1e293b !important; }
      [data-ogsc] .d-warm, [data-ogsb] .d-warm { background-color: #1a1a2e !important; }
      [data-ogsc] .d-steps, [data-ogsb] .d-steps { background-color: #16213e !important; }
      [data-ogsc] .d-text, [data-ogsb] .d-text { color: #f1f5f9 !important; }
      [data-ogsc] .d-muted, [data-ogsb] .d-muted { color: #94a3b8 !important; }
      [data-ogsc] .d-cta, [data-ogsb] .d-cta { background-color: #0c4a3e !important; }
      [data-ogsc] .d-footer, [data-ogsb] .d-footer { background-color: #0f172a !important; }
      [data-ogsc] .d-badge, [data-ogsb] .d-badge { background-color: #134e4a !important; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f1f5f9" css-class="d-bg">

    <mj-wrapper background-color="#ffffff" padding="0 16px" border-radius="16px" css-class="d-card">

      <!-- Green accent bar -->
      <mj-section padding="0" background-color="#00A669">
        <mj-column padding="3px 0">
          <mj-text padding="0" font-size="1px">&nbsp;</mj-text>
        </mj-column>
      </mj-section>

      <!-- Logo + Badge -->
      <mj-section padding="24px 24px 0" background-color="#ffffff">
        <mj-column width="60%" padding="0" vertical-align="middle">
          <mj-image src="{{logoUrl}}" alt="{{brandName}}" width="140px" padding="0" align="left" />
        </mj-column>
        <mj-column width="40%" padding="0" vertical-align="middle">
          <mj-text align="right" padding="0" font-size="12px" font-weight="500" color="#64748B">
            <span style="display:inline-block;background-color:#f1f5f9;color:#475569;border-radius:100px;padding:4px 12px;line-height:1.3;">User Approved</span>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Hero (warm cream bg) -->
      <mj-section padding="24px 24px" background-color="#FEF7EE" css-class="d-warm">
        <mj-column width="55%" padding="0 16px 0 0" vertical-align="middle">
          <mj-text padding="0 0 8px" font-size="12px" font-weight="600" color="#00A669">
            <span style="text-transform:uppercase;letter-spacing:2px;">Welcome aboard!</span>
          </mj-text>
          <mj-text font-size="24px" font-weight="700" color="#1E293B" padding="0" line-height="1.2" css-class="d-text">
            Congratulations!
          </mj-text>
          <mj-text padding="6px 0 0" font-size="1px" line-height="1">
            <div style="border-bottom:3px solid #00A669;width:60px;font-size:1px;line-height:1;">&nbsp;</div>
          </mj-text>
          <mj-text font-size="15px" font-weight="400" color="#475569" padding="16px 0 4px" css-class="d-text">
            Hi {{supplierBusinessName}},
          </mj-text>
          <mj-text font-size="14px" font-weight="400" color="#64748B" padding="0" line-height="1.6" css-class="d-muted">
            Your application has been approved. We're thrilled to welcome you to {{brandName}} &mdash; you're now ready to share your unique tours with travelers around the world.
          </mj-text>
        </mj-column>
        <mj-column width="45%" padding="0" vertical-align="middle">
          <mj-image src="{{heroImageUrl}}" alt="" width="200px" padding="0" align="right" border-radius="12px" fluid-on-mobile="true" css-class="hero-img" />
        </mj-column>
      </mj-section>

      <!-- Steps heading -->
      <mj-section padding="28px 24px 0" background-color="#ffffff">
        <mj-column width="100%" padding="0">
          <mj-text font-size="18px" font-weight="700" color="#1E293B" align="center" padding="0 0 4px" css-class="d-text">
            Your next steps
          </mj-text>
          <mj-text font-size="13px" font-weight="400" color="#64748B" align="center" padding="0" css-class="d-muted">
            Three simple steps to start growing your business.
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Steps (light green bg) -->
      <mj-section padding="24px 24px" background-color="#F0FDF4" css-class="d-steps">
        <mj-column width="100%" padding="0">

          <mj-text padding="0 0 20px 0">
            <table cellpadding="0" cellspacing="0" border="0" style="width:100%;">
              <tr>
                <td style="width:48px;vertical-align:top;padding-top:2px;">
                  <span style="display:inline-block;width:36px;height:36px;border-radius:50%;background-color:#00A669;color:#ffffff;text-align:center;line-height:36px;font-size:14px;font-weight:700;">1</span>
                </td>
                <td style="vertical-align:top;padding-left:16px;">
                  <div style="font-size:16px;font-weight:700;color:#1E293B;margin-bottom:4px;">Set up payment</div>
                  <div style="font-size:14px;font-weight:400;color:#64748B;line-height:1.6;">Set up your payout method to start receiving payments securely and on time.</div>
                </td>
              </tr>
            </table>
          </mj-text>

          <mj-text padding="0 0 20px 0" font-size="1px" line-height="1">
            <div style="border-top:1px dashed #D1FAE5;font-size:1px;line-height:1;">&nbsp;</div>
          </mj-text>

          <mj-text padding="0 0 20px 0">
            <table cellpadding="0" cellspacing="0" border="0" style="width:100%;">
              <tr>
                <td style="width:48px;vertical-align:top;padding-top:2px;">
                  <span style="display:inline-block;width:36px;height:36px;border-radius:50%;background-color:#00A669;color:#ffffff;text-align:center;line-height:36px;font-size:14px;font-weight:700;">2</span>
                </td>
                <td style="vertical-align:top;padding-left:16px;">
                  <div style="font-size:16px;font-weight:700;color:#1E293B;margin-bottom:4px;">Create your tour</div>
                  <div style="font-size:14px;font-weight:400;color:#64748B;line-height:1.6;">List your tours, set availability, and start reaching travelers from around the world.</div>
                </td>
              </tr>
            </table>
          </mj-text>

          <mj-text padding="0 0 20px 0" font-size="1px" line-height="1">
            <div style="border-top:1px dashed #D1FAE5;font-size:1px;line-height:1;">&nbsp;</div>
          </mj-text>

          <mj-text padding="0">
            <table cellpadding="0" cellspacing="0" border="0" style="width:100%;">
              <tr>
                <td style="width:48px;vertical-align:top;padding-top:2px;">
                  <span style="display:inline-block;width:36px;height:36px;border-radius:50%;background-color:#00A669;color:#ffffff;text-align:center;line-height:36px;font-size:14px;font-weight:700;">3</span>
                </td>
                <td style="vertical-align:top;padding-left:16px;">
                  <div style="font-size:16px;font-weight:700;color:#1E293B;margin-bottom:4px;">Complete profile</div>
                  <div style="font-size:14px;font-weight:400;color:#64748B;line-height:1.6;">Tell travelers about your business, add photos, and showcase what makes your tours unique.</div>
                </td>
              </tr>
            </table>
          </mj-text>

        </mj-column>
      </mj-section>

      <!-- Approval date -->
      <mj-section padding="24px 24px 0" background-color="#ffffff">
        <mj-column width="100%" padding="0">
          <mj-text font-size="12px" color="#94a3b8" align="center" padding="0" css-class="d-muted">
            Approved on {{approvalDate}}
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- CTA -->
      <mj-section padding="24px 24px 0" background-color="#ffffff">
        <mj-column width="100%" padding="28px 20px" background-color="#001F3F" css-class="d-cta">
          <mj-text font-size="18px" font-weight="700" color="#ffffff" align="center" padding="0 0 6px">
            Ready to start your journey?
          </mj-text>
          <mj-text font-size="14px" font-weight="400" color="#94a3b8" align="center" padding="0 0 20px">
            Access your dashboard to manage listings, bookings, and grow your business.
          </mj-text>
          <mj-button href="{{dashboardUrl}}" background-color="#00A669" color="#ffffff" font-size="13px" font-weight="700" padding="0" border-radius="10px" inner-padding="12px 16px" align="center" target="_blank">
            Open Dashboard &rarr;
          </mj-button>
        </mj-column>
      </mj-section>

      <!-- Support -->
      <mj-section padding="24px 24px 0" background-color="#ffffff">
        <mj-column width="100%" padding="0">
          <mj-text font-size="13px" color="#64748B" align="center" padding="0 0 4px" css-class="d-muted">
            Questions? We're here to help.
          </mj-text>
          <mj-text font-size="13px" font-weight="600" color="#00A669" align="center" padding="0">
            <a href="mailto:{{supportEmail}}" style="color:#00A669;text-decoration:none;">{{supportEmail}}</a>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Footer -->
      <mj-section padding="24px 24px 28px" background-color="#ffffff">
        <mj-column width="100%" padding="0">
          <mj-text font-size="11px" color="#94a3b8" align="center" padding="0 0 12px" css-class="d-muted">
            <a href="#" style="color:#94a3b8;text-decoration:none;margin:0 6px;">Twitter</a>
            <span style="color:#cbd5e1;">&#183;</span>
            <a href="#" style="color:#94a3b8;text-decoration:none;margin:0 6px;">Facebook</a>
            <span style="color:#cbd5e1;">&#183;</span>
            <a href="#" style="color:#94a3b8;text-decoration:none;margin:0 6px;">Instagram</a>
            <span style="color:#cbd5e1;">&#183;</span>
            <a href="#" style="color:#94a3b8;text-decoration:none;margin:0 6px;">LinkedIn</a>
          </mj-text>
          <mj-text font-size="13px" color="#1E293B" align="center" font-weight="600" padding="0" css-class="d-text">
            Welcome aboard &mdash; {{brandName}} Team
          </mj-text>
        </mj-column>
      </mj-section>

    </mj-wrapper>

    <!-- Copyright -->
    <mj-section padding="10px 16px">
      <mj-column width="600px" padding="0">
        <mj-text font-size="10px" color="#94a3b8" align="center" padding="0" css-class="d-muted">
          &copy; {{year}} {{brandName}} by Expedition-Go Tours. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
