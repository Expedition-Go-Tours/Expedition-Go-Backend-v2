NODE_ENV=development
PORT=5000

# PostgreSQL Database — production uses Neon (direct endpoint, NOT pgbouncer)
# DATABASE_URL   = Neon direct connection (remove -pooler from host, remove pgbouncer=true)
# DIRECT_URL     = Same direct URL (used by Prisma for migrations only)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/travio
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/travio

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Client URLs
CLIENT_URL=http://localhost:5173
SUPPLIER_DASHBOARD_URL=http://localhost:5174

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
LOGO_URL=
EMAIL_REPLY_TO=

# Redis — production is the Redis container on the Hetzner VPS (redis://redis:6379)
REDIS_URL=redis://localhost:6379

# JWT Secrets (required in production)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Sentry
SENTRY_DSN=

# MiMo AI (Xiaomi) — for tour image analysis and content classification
# Get your key at https://api.xiaomimimo.com
MIMO_API_KEY=

# Allowed Origins (comma-separated)
ALLOWED_ORIGINS=

# Rate limiting (optional — defaults used if not set)
# RATELIMIT_GLOBAL_MAX=500
# RATELIMIT_GLOBAL_WINDOW_MS=3600000
# RATELIMIT_AUTH_MAX=20
# RATELIMIT_AUTH_WINDOW_MS=900000
# RATELIMIT_UPLOAD_MAX=20
# RATELIMIT_UPLOAD_WINDOW_MS=3600000
# RATELIMIT_CONTACT_MAX=5
# RATELIMIT_CONTACT_WINDOW_MS=900000
# RATELIMIT_SUBSCRIBE_MAX=10
# RATELIMIT_SUBSCRIBE_WINDOW_MS=60000
# RATELIMIT_ADMIN_MAX=200
# RATELIMIT_ADMIN_WINDOW_MS=900000
# RATELIMIT_LOCATION_MAX=120
# RATELIMIT_LOCATION_WINDOW_MS=60000
# RATELIMIT_TEAM_INVITE_MAX=10
# RATELIMIT_TEAM_INVITE_WINDOW_MS=3600000
# RATELIMIT_INVITE_LOOKUP_MAX=30
# RATELIMIT_INVITE_LOOKUP_WINDOW_MS=900000

# Logtail (optional)
LOGTAIL_TOKEN=

# Discord Ops Hub webhooks (optional — feature is disabled when unset)
DISCORD_WEBHOOK_DEPLOYS=
DISCORD_WEBHOOK_INCIDENTS=
DISCORD_WEBHOOK_SALES=
DISCORD_WEBHOOK_VERIFICATION=
DISCORD_WEBHOOK_DIGEST=
DISCORD_WEBHOOK_APPROVALS=
