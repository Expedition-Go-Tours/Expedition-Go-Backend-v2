// Production-Ready Tour Booking Platform Schema
// Supports: Multi-role users, Tours, Bookings, Reviews, Payments, Notifications
// Last Updated: May 12, 2026

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ================================
// ENUMS
// ================================

enum UserRole {
  customer
  supplier
  admin
  expedition
}

enum SupplierStatus {
  PENDING // Initial application submitted
  UNDER_REVIEW // Admin reviewing application
  APPROVED // Admin approved
  ACTIVE // Fully verified and can receive payouts
  SUSPENDED // Temporarily suspended
  REJECTED // Application rejected
  EXPIRED // Required document(s) expired — services hidden until renewed
}

enum SupplierType {
  TOUR_GUIDE
  TOUR_COMPANY
  ACCOMMODATION_PROVIDER
  TRANSPORTATION_PROVIDER
  VEHICLE_OPERATOR
  OTHER_SERVICE_PROVIDER
}

enum DocumentType {
  GHANA_CARD
  NATIONAL_ID
  TOUR_GUIDE_LICENCE
  DRIVERS_LICENCE
  BUSINESS_CERTIFICATE
  GTA_CERTIFICATE
  PROOF_OF_ADDRESS
  PROFILE_PHOTO
  PASSENGER_TRANSPORT_LICENCE
  VEHICLE_REGISTRATION
  VEHICLE_OWNERSHIP
  VEHICLE_ROADWORTHINESS
  VEHICLE_INSURANCE
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  REPLACEMENT_REQUESTED
  EXPIRED
}

enum VerificationTarget {
  SUPPLIER
  VEHICLE
  GUIDE
}

enum VehicleStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum GuideStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PayoutStatus {
  PENDING // Booking confirmed, awaiting finance approval
  APPROVED // Finance approved, queued for payment
  PROCESSING // Payment initiated
  PAID // Funds sent to supplier
  FAILED // Payment failed
  CANCELLED // Payout cancelled
}

// Lifecycle of a booking's supplier payout portion (finance v2).
// PENDING   → paid, in escrow until travel date passes (+ clearance buffer)
// ELIGIBLE  → travel completed with no dispute; withdrawable during an open window
// REQUESTED → included in a submitted PayoutRequest (locked)
// PAID      → funds released to the supplier (ledger row exists)
// DISPUTED  → an open dispute/refund freezes the funds
// CANCELLED → terminal: refunded/cancelled, supplier never gets paid
enum BookingPayoutStatus {
  PENDING
  ELIGIBLE
  REQUESTED
  PAID
  DISPUTED
  CANCELLED
}

enum PayoutRequestStatus {
  PROCESSING // Supplier submitted the batch withdrawal request
  APPROVED // Admin authorized the release
  COMPLETED // Funds confirmed sent; ledger rows created
  REJECTED // Admin rejected the request
  CANCELLED // Withdrawn/superseded before completion
}

enum DisputeStatus {
  OPEN // Supplier just filed the refund request, awaiting review
  UNDER_REVIEW // Admin is actively reviewing
  RESOLVED_CUSTOMER // Refund approved — customer refunded, supplier payout cancelled
  RESOLVED_SUPPLIER // Request denied — payout unfrozen back to eligible
  WITHDRAWN // Supplier withdrew their refund request
}

enum PayoutMethodType {
  BANK_TRANSFER
  PAYPAL
}

enum BookingSource {
  TRAVIO
  EXPEDITION
}

enum BookingFlow {
  DIRECT // Booked on Expedition Go (EG's own supplier tours)
  EXTERNAL // Redirected to TravioAfrica (other suppliers)
}

enum BookingStatus {
  PENDING // Payment processing
  CONFIRMED // Payment successful
  CANCELLED // Cancelled by customer
  REFUNDED // Refunded
  COMPLETED // Tour completed
  NO_SHOW // Customer didn't show up
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_RECEIVED
  REVIEW_RECEIVED
  SUPPLIER_APPROVED
  SUPPLIER_REJECTED
  PAYOUT_PROCESSED
  PAYOUT_APPROVED
  PAYOUT_COMPLETED
  PAYOUT_REQUEST_SUBMITTED
  PAYOUT_REQUEST_APPROVED
  PAYOUT_REQUEST_REJECTED
  SYSTEM_ALERT
  NEW_MESSAGE
  TOUR_SUBMITTED
  TOUR_APPROVED
  TOUR_FLAGGED
  DOCUMENT_REJECTED
  DOCUMENT_EXPIRY_REMINDER
  DOCUMENT_EXPIRED
}

enum AdminNotificationType {
  NEW_SUPPLIER_APPLICATION
  SUPPLIER_STATUS_CHANGE
  REVIEW_NEEDS_MODERATION
  PAYOUT_NEEDS_APPROVAL
  SYSTEM_ALERT
  NEW_MESSAGE
  TOUR_SUBMITTED_FOR_REVIEW
  BOOKING_CREATED
  BOOKING_CONFIRMED
  DOCUMENT_EXPIRING
  DOCUMENT_EXPIRED
  REFUND_REQUEST
  PAYMENT_UPCOMING
  PAYMENT_COLLECTED
  PAYMENT_COLLECTION_FAILED
  STRIPE_CUSTOMER_CREATE_FAILED
  REFUND_NEEDS_ATTENTION
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum TourStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  PAUSED
  ARCHIVED
}

enum SpecialOfferType {
  LIMITED_TIME
  EARLY_BIRD
  LAST_MINUTE
}

enum SpecialOfferCapacityType {
  UNLIMITED
  CAPPED
}

enum SpecialOfferTimeSlotMode {
  ALL_DAYS
  SPECIFIC_WEEKDAYS
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum OverrideStatus {
  AVAILABLE
  LIMITED
  FULL
  BLOCKED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum KeywordRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MediaStatus {
  PENDING
  ATTACHED
  ORPHANED
}

model Media {
  id       String      @id @default(cuid())
  url      String      @unique
  publicId String?
  userId   String?
  status   MediaStatus @default(PENDING)
  entity   String?
  entityId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([url])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ================================
// CORE MODELS
// ================================

model User {
  id           String     @id @default(cuid())
  firebaseUid  String?    @unique
  name         String
  email        String     @unique
  passwordHash String?
  authProvider String     @default("local")
  refreshToken String?
  photoURL     String     @default("")
  logoUrl      String?
  phone        String?
  roles        UserRole[] @default([customer])

  // Stripe Integration
  stripeCustomerId String? @unique

  // Profile & Preferences
  // Legacy wishlist storage (plain tour-ID array, no per-item timestamps).
  // Kept for the one-time data backfill — WishlistItem is now the source of
  // truth and this column is no longer read by any controller. Drop it in a
  // follow-up deploy once scripts/backfill-wishlist.js has confirmed the copy.
  wishlist String[]
  likes    String[]
  language String   @default("en")
  timezone String   @default("UTC")

  // Notification Preferences (JSON object with email/push categories)
  notificationPreferences Json?

  // Account Status
  active        Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?

  // Admin Role (only for admins — determines granular permissions)
  adminRoleId String?
  adminRole   AdminRole? @relation(fields: [adminRoleId], references: [id])

  // Supplier Information (only for suppliers)
  supplierProfile SupplierProfile?

  // Relationships
  tours                      Tour[]
  bookings                   Booking[]
  payouts                    Payout[]
  payoutMethods              PayoutMethod[]
  payoutRequests             PayoutRequest[]
  disputesOpened             Dispute[]           @relation("DisputeOpener")
  disputesAgainst            Dispute[]           @relation("DisputeSupplier")
  disputesResolved           Dispute[]           @relation("DisputeResolver")
  reviews                    Review[]
  notifications              Notification[]
  cartItems                  CartItem[]
  teamMembers                TeamMember[]              @relation("SupplierTeam")
  teamInvitations            TeamMember[]              @relation("TeamInviter")
  chatParticipants           ConversationParticipant[]
  messages                   Message[]
  specialOffers              SpecialOffer[]
  expeditionTours            ExpeditionTour[]
  publishedExpeditionTours   ExpeditionTour[]          @relation("ExpeditionPublishedBy")
  unpublishedExpeditionTours ExpeditionTour[]          @relation("ExpeditionUnpublishedBy")
  articles                   Article[]
  keywordRequests            KeywordRequest[]
  wishlistItems              WishlistItem[]
  checkoutDrafts             CheckoutDraft[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roles], type: Gin) // GIN for array column performance
  @@index([email])
  @@index([createdAt])
  @@index([stripeCustomerId])
}

// Wishlist with per-entry timestamps. Replaces the legacy User.wishlist
// String[] column: gives real "added at" dates, stable ordering, idempotent
// add/remove (compound unique), and cascade cleanup when a user or tour is
// deleted. Populated for pre-existing data by scripts/backfill-wishlist.js.
model WishlistItem {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tourId  String
  tour    Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@unique([userId, tourId])
  @@index([userId, addedAt])
  @@index([tourId])
}

model SupplierProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Status & Verification
  status       SupplierStatus @default(PENDING)
  supplierType SupplierType   @default(TOUR_COMPANY)

  // Business Information
  businessInfo       Json // Structured business details
  operatingInfo      Json // Operating information
  representativeInfo Json // Representative details
  businessDocuments  Json // Document URLs
  payoutInfo         Json // Payout preferences
  compliance         Json // Terms acceptance & verification

  // Admin Review
  adminNotes String?
  reviewedBy String? // Admin user ID
  reviewedAt DateTime?

  // Verification sub-records (documents, vehicles, guides, history)
  documents          SupplierDocument[]
  vehicles           Vehicle[]
  guides             Guide[]
  verificationEvents VerificationEvent[]

  // Archive/Restore (soft-delete lifecycle)
  // JSON: { "archivedAt": ISO string, "tourIds": string[] } — captures exactly
  // which tours the archive action hid, so restore reactivates only those.
  archiveSnapshot Json?

  // Statistics
  totalEarnings Decimal  @default(0) @db.Decimal(10, 2)
  totalBookings Int      @default(0)
  averageRating Decimal? @db.Decimal(3, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// An individual verification document (one row per uploaded file). Gives
// per-document status, expiry and a permanent decision history — replacing
// the legacy businessDocuments JSON blob for all new applications.
model SupplierDocument {
  id         String          @id @default(cuid())
  supplierId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  ownerType VerificationTarget @default(SUPPLIER)
  ownerId   String? // vehicleId / guideId when ownerType != SUPPLIER
  type      DocumentType

  url      String
  filename String?

  status     DocumentStatus @default(PENDING)
  expiryDate DateTime? // recorded for licences/certificates with a valid-until date
  reviewNote String?

  reviewedBy String? // Admin user ID
  reviewedAt DateTime? // last review decision timestamp

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId, status])
  @@index([ownerType, ownerId])
  @@index([status, expiryDate])
  @@index([type])
}

// Immutable audit trail: what was verified, when, when it expires, and by whom.
model VerificationEvent {
  id         String          @id @default(cuid())
  supplierId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  entityType VerificationTarget
  entityId   String?
  action     String // APPROVED | REJECTED | REPLACEMENT_REQUESTED | EXPIRED | STATUS_CHANGE
  actorId    String? // Admin user ID (or SYSTEM for scheduled expiry)
  note       String?

  createdAt DateTime @default(now())

  @@index([supplierId, createdAt])
  @@index([entityType, entityId])
}

model Vehicle {
  id         String          @id @default(cuid())
  supplierId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  make               String
  model              String
  year               Int?
  registrationNumber String
  photos             String[]

  status     VehicleStatus @default(PENDING)
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId, status])
  @@index([registrationNumber])
}

model Guide {
  id         String          @id @default(cuid())
  supplierId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  userId   String? // optional link to a User when the guide has their own account
  fullName String
  phone    String?
  email    String?

  status     GuideStatus @default(PENDING)
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId, status])
}

model PayoutMethod {
  id         String @id @default(cuid())
  supplierId String
  supplier   User   @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  type      PayoutMethodType
  isDefault Boolean          @default(false)
  currency  String           @default("USD")

  // Bank Transfer fields
  bankName      String?
  bankAddress   String?
  bankCountry   String? // ISO 3166-1 alpha-2, e.g. GH, NG, US
  accountName   String?
  accountNumber String?
  routingNumber String? // ABA routing (US)
  swiftCode     String? // SWIFT/BIC (international)
  iban          String? // International Bank Account Number
  sortCode      String? // Sort code (UK, Ghana, etc.)
  branchCode    String? // Branch/bank code (Nigeria, etc.)
  branchName    String? // Bank branch name, e.g. Oxford Circus

  // PayPal fields
  paypalEmail String?

  // Status
  verified Boolean @default(false)

  payouts Payout[] // Payouts that used this method
  payoutRequests PayoutRequest[] // Payout requests paid to this method

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
}

model Tour {
  id         String @id @default(cuid())
  supplierId String
  supplier   User   @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // Basic Information
  title         String
  description   String
  referenceCode String?
  photos        String[]
  coverPhoto    String?
  status        TourStatus @default(DRAFT)

  // Review / Moderation (submit-for-review workflow)
  submittedAt DateTime? // When supplier last submitted for review
  reviewedBy  String? // Admin user ID who made the last review decision
  reviewedAt  DateTime? // When the last review decision was made
  reviewNote  String? // Admin note shown to the supplier when flagged

  // Draft / Edit-approval (live-tour edits wait here; the live version keeps selling)
  draftContent     Json? // Full edited product snapshot (live columns stay untouched)
  draftStatus      String? // DRAFT | PENDING_APPROVAL | REJECTED
  draftSubmittedAt DateTime?
  draftReviewedAt  DateTime?
  draftReviewNote  String? // Admin note for a rejected draft

  // Categorization (JSON structure as per your model)
  categorization Json
  theme          Json

  // Product Content
  productContent Json

  // Schedules & Pricing
  schedulesAndPricing Json

  // Booking & Tickets
  bookingAndTickets Json

  // SEO & Marketing
  slug            String   @unique
  metaTitle       String?
  metaDescription String?
  tags            String[]

  // Location (PostGIS coordinates)
  latitude   Float? // Used with PostGIS ST_DWithin for geo-search
  longitude  Float? // Used with PostGIS ST_DWithin for geo-search
  city       String? // Extracted from productContent.location.city for indexed filtering
  country    String? // Extracted from productContent.location.country for indexed filtering
  region     String? // Extracted from productContent.location.region for indexed filtering
  attractions String[] @default([]) // Extracted from productContent.locations[].name — specific attraction/stop names

  // Normalized categorization (extracted from categorization JSON for indexed filtering)
  category        String? // e.g. "Adventure", "Cultural", "Nature"
  subcategory     String? // e.g. "Walking Tours", "Hiking"
  activityType    String? // e.g. "Guided Tour", "Self-Guided"
  difficulty      String? // e.g. "Easy", "Moderate", "Challenging", "Expert"
  durationMinutes Int? // Extracted from categorization.duration (hours*60 or days*1440)

  // Normalized theme (extracted from theme JSON)
  primaryTheme String? // e.g. "Nature & Wildlife", "History & Culture"

  // PostGIS geography column — managed via raw SQL, not by Prisma
  // (trigger function update_tour_location() populates it from lat/lng)
  location_geom Unsupported("geography(Point, 4326)")?

  // AI enrichment (Populated asynchronously by MiMo via BullMQ)
  aiPrimaryCategory     String?   // MiMo's primary classification (e.g. "sports_adventure")
  aiSecondaryCategories String[]  @default([]) // MiMo's secondary classifications
  aiMoodTags            String[]  @default([]) // AI-derived mood/vibe tags
  aiActivityLevel       String?   // "low" | "medium" | "high"
  aiConfidence          Float?    // 0.0–1.0, how confident MiMo is
  aiScoredAt            DateTime? // When AI last processed this tour
  aiProcessingStatus    String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED

  // CLIP embeddings (self-hosted, zero-cost image/text vectors)
  clipEmbedding     Json?       // Average CLIP image embedding (512 floats)
  clipTextEmbedding Json?       // CLIP text embedding of title+description (512 floats)

  // Statistics
  totalBookings Int      @default(0)
  totalRevenue  Decimal  @default(0) @db.Decimal(10, 2)
  averageRating Decimal? @db.Decimal(3, 2)
  reviewCount   Int      @default(0)
  viewCount     Int      @default(0)

  // Relationships
  bookings            Booking[]
  reviews             Review[]
  cartItems           CartItem[]
  dateOverrides       TourDateOverride[]
  secondaryThemes     TourSecondaryTheme[]
  specialOfferTargets SpecialOfferTarget[]
  expeditionTour      ExpeditionTour?
  articles            ArticleTour[]
  wishlistItems       WishlistItem[]
  checkoutDrafts      CheckoutDraft[]
  dailyStats          DailyTourStats[]
  imageAnalyses       TourImageAnalysis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([supplierId, status]) // Supplier dashboard: my tours by status
  @@index([status])
  @@index([status, submittedAt]) // Admin moderation queue ordering
  @@index([slug])
  @@index([createdAt])
  @@index([averageRating])
  @@index([city])
  @@index([country])
  @@index([region])
  @@index([country, city])
  @@index([category])
  @@index([subcategory])
  @@index([activityType])
  @@index([difficulty])
  @@index([primaryTheme])
  @@index([durationMinutes])
}

model TourDateOverride {
  id                String         @id @default(cuid())
  tourId            String
  tour              Tour           @relation(fields: [tourId], references: [id], onDelete: Cascade)
  date              DateTime       @db.Date
  status            OverrideStatus @default(AVAILABLE)
  capacity          Int?
  timeSlotOverrides Json? // [{ time: "09:00", capacity: 10, booked: 0 }, ...]
  notes             String?

  @@unique([tourId, date])
  @@index([tourId, date])
}

model DailyTourStats {
  id              String   @id @default(cuid())
  tourId          String
  tour            Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  totalViews      Int      @default(0)
  uniqueVisitors  Int      @default(0)
  topCountry      String?  @db.VarChar(2)
  topReferrer     String?
  createdAt       DateTime @default(now())

  @@unique([tourId, date])
  @@index([tourId, date])
  @@index([date])
}

model TourSecondaryTheme {
  id     String @id @default(cuid())
  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  theme  String

  @@unique([tourId, theme])
  @@index([theme])
  @@index([tourId])
}

model SpecialOffer {
  id         String @id @default(cuid())
  supplierId String
  supplier   User   @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  name               String
  offerType          SpecialOfferType
  discountType       DiscountType     @default(PERCENTAGE)
  discountPercentage Int              @default(10)
  fixedDiscountValue Float?
  startDate          DateTime?
  endDate            DateTime?
  isActive           Boolean          @default(true)

  capacityType SpecialOfferCapacityType @default(UNLIMITED)
  maxSpots     Int?
  spotsSold    Int                      @default(0)

  timeSlotMode     SpecialOfferTimeSlotMode @default(ALL_DAYS)
  specificWeekdays String[]                 @default([])

  earlyBirdAdvanceDays  Int?
  lastMinuteWindowHours Int?

  promoCode                 String? @unique
  minQuantity               Int?
  minSpendAmount            Float?
  maxRedemptionsPerCustomer Int?
  stackable                 Boolean @default(false)

  targets  SpecialOfferTarget[]
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([isActive, startDate, endDate])
  @@index([offerType])
}

model SpecialOfferTarget {
  id             String       @id @default(cuid())
  specialOfferId String
  specialOffer   SpecialOffer @relation(fields: [specialOfferId], references: [id], onDelete: Cascade)

  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  tourOptionKey   String?
  tourOptionLabel String?

  @@unique([specialOfferId, tourId, tourOptionKey])
  @@index([tourId])
  @@index([tourOptionKey])
}

model Booking {
  id            String @id @default(cuid())
  bookingNumber String @unique // Human-readable booking reference

  // Relationships
  customerId String
  customer   User   @relation(fields: [customerId], references: [id])
  tourId     String
  tour       Tour   @relation(fields: [tourId], references: [id])

  // Booking Details
  source       BookingSource @default(TRAVIO)
  status       BookingStatus @default(PENDING)
  travelers    Json // Traveler information
  travelDate   DateTime @map("selectedDate")
  selectedTime String?
  isSimulated  Boolean       @default(false)

  // Lead traveler captured on the storefront (the person going on the trip).
  // Distinct from the customer account that placed the booking. Nullable so
  // legacy/guest bookings fall back to the account holder.
  leadTravelerName  String?
  leadTravelerEmail String?
  leadTravelerPhone String?

  // Pricing
  subtotal  Decimal @db.Decimal(10, 2)
  taxes     Decimal @default(0) @db.Decimal(10, 2)
  fees      Decimal @default(0) @db.Decimal(10, 2)
  discounts Decimal @default(0) @db.Decimal(10, 2)
  grossAmount Decimal @map("total") @db.Decimal(10, 2)
  currency  String  @default("USD")

  // Commission & Payouts
  commissionRate   Decimal @db.Decimal(5, 4) // e.g., 0.1500 for 15%
  platformCommission Decimal @map("commissionAmount") @db.Decimal(10, 2)
  supplierPayout   Decimal @db.Decimal(10, 2)

  // Finance v2 — fund lifecycle (see BookingPayoutStatus enum)
  payoutStatus BookingPayoutStatus @default(PENDING)

  // Payment Information
  stripePaymentIntentId   String?
  stripeCheckoutSessionId String?
  paymentStatus           PaymentStatus @default(PENDING)
  paidAt                  DateTime?
  // 'now' = charged at booking (Pay now), 'later' = Reserve now, pay later
  paymentTiming         String        @default("now")
  // Pay-later retry tracking (max 3 retries before cancellation)
  chargeRetries         Int           @default(0)
  nextRetryAt           DateTime?

  // Cancellation
  cancellationReason String?
  cancelledAt        DateTime?
  refundAmount       Decimal?  @db.Decimal(10, 2)
  refundedAt         DateTime?

  // Communication
  specialRequests String?
  supplierNotes   String?

  // Customer-selected pickup snapshot (mode, area/location, address, time).
  // Null when the tour has no pickup service.
  pickup Json?

  // Applied special offer (if any)
  appliedOfferId String?
  appliedOffer   SpecialOffer? @relation(fields: [appliedOfferId], references: [id], onDelete: SetNull)

  // Offer snapshot fields (denormalized for historical accuracy — preserved even if the offer is edited/deleted)
  offerName         String?
  offerPromoCode    String?
  offerDiscountType String?  // PERCENTAGE or FIXED
  offerDiscountPct  Int?
  offerDiscountFix  Float?

  // Relationships
  review    Review?
  payouts   Payout[]
  payoutRequestItems PayoutRequestItem[]
  disputes  Dispute[]
  reminders BookingReminder[]
  changes   BookingChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([tourId])
  @@index([status])
  @@index([travelDate])
  @@index([bookingNumber])
  @@index([stripePaymentIntentId])
  @@index([stripeCheckoutSessionId])
  @@index([tourId, status, travelDate]) // Capacity checks + supplier booking lookup
  @@index([customerId, status, travelDate]) // "My bookings" filtered pages
  @@index([status, travelDate]) // Admin/supplier date-range queries
  @@index([payoutStatus]) // Finance eligibility sweeps + KPI queries
}

model BookingReminder {
  id           String    @id @default(cuid())
  bookingId    String
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type         String // e.g. PAYMENT_DUE_24H, BOOKING_24H, REVIEW_REQUEST, PICKUP_LOCATION_REQUIRED
  scheduledFor DateTime
  sentAt       DateTime?
  status       String    @default("PENDING") // PENDING | SENT | FAILED | SKIPPED
  error        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([bookingId, type])
  @@index([type, status, scheduledFor])
}

model BookingChange {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedBy String // customer | supplier | platform
  reason    String?
  previous  Json // Snapshot of the changed fields before (e.g. { selectedDate, travelers })
  updated   Json // Snapshot of the changed fields after
  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([changedBy])
}

// Pay-now checkout hold (Expedition storefront). A short-lived atomic seat
// reservation created BEFORE the customer is redirected to Stripe Checkout.
// No Booking row exists until the checkout.session.completed webhook
// materializes one from the stored payload + pricing snapshot. Holds occupy
// capacity (availabilityCore counts status='HOLDING', unexpired) and are
// released by the expired-session webhook or the expire-checkout-holds sweep.
model CheckoutDraft {
  id             String   @id @default(cuid())
  customerId     String
  customer       User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tourId         String
  tour           Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  // Slot being held
  travelDate   DateTime @map("selectedDate")
  selectedTime String?
  seats        Int // Numeric traveler headcount occupying capacity

  // Frozen at acquisition: exact validated request body + server-computed
  // pricing/commission, so the webhook can materialize the Booking without
  // re-trusting anything from the client.
  payload Json
  pricing Json

  commissionRate     Decimal @db.Decimal(5, 4)
  platformCommission Decimal @map("commissionAmount") @db.Decimal(10, 2)
  supplierPayout     Decimal @db.Decimal(10, 2)
  currency           String  @default("USD")

  stripeSessionId String? @unique
  // HOLDING  — seats reserved, awaiting payment
  // PAID     — converted to a Booking by the completed webhook
  // EXPIRED  — released (expired session / sweep / abandoned)
  // REFUNDED — payment landed but capacity vanished mid-hold; money returned
  status    String   @default("HOLDING")
  expiresAt DateTime
  bookingId String? // Set when materialized (PAID/REFUNDED bookkeeping)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tourId, travelDate, status]) // Hold-aware capacity checks
  @@index([status, expiresAt]) // Expiry sweep
  @@index([customerId]) // "My checkouts" + dedup guard
}

model Payout {
  id String @id @default(cuid())

  // Who gets paid
  supplierId String
  supplier   User   @relation(fields: [supplierId], references: [id])

  // What booking this payout is for
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  // Amounts
  amount           Decimal @db.Decimal(10, 2)
  currency         String  @default("USD")
  commissionAmount Decimal @db.Decimal(10, 2)

  // Status
  status PayoutStatus @default(PENDING)

  // Finance processing
  approvedAt  DateTime?
  approvedBy  String? // Admin user ID who approved
  processedAt DateTime?
  processedBy String? // Admin user ID who processed
  paidAt      DateTime?

  // The specific payout method used (linked record)
  payoutMethodId String?
  payoutMethod   PayoutMethod? @relation(fields: [payoutMethodId], references: [id])

  // Payment details
  paymentMethod String? // "bank_transfer", "paypal"
  reference     String? // Transaction reference from payment provider
  notes         String? // Admin notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@index([supplierId, status])
  @@index([supplierId, createdAt])
  @@index([bookingId])
  @@index([payoutMethodId])
}

// ── Finance v2: batch withdrawal requests ──
// A supplier groups their ELIGIBLE bookings into a single PayoutRequest during
// an open bi-monthly window (16th–20th or 1st–5th). Admin approves → completes;
// completion cascades ledger Payout rows + Booking.payoutStatus = PAID.

model PayoutRequest {
  id            String @id @default(cuid())
  requestNumber String @unique // Human-readable reference e.g. PR-20260816-XXXX

  // Who gets paid
  supplierId String
  supplier   User   @relation(fields: [supplierId], references: [id])

  // Amounts (all items share one currency — mixed currencies split into separate requests)
  amount       Decimal @db.Decimal(10, 2)
  currency     String  @default("USD")
  bookingCount Int

  status PayoutRequestStatus @default(PROCESSING)

  // Bi-monthly cycle this request belongs to
  cycleStartDate DateTime
  cycleEndDate   DateTime
  cycleLabel     String // e.g. "Aug 1–15"

  // Destination account snapshot at request time
  payoutMethodId String?
  payoutMethod   PayoutMethod? @relation(fields: [payoutMethodId], references: [id])

  // Admin processing
  approvedBy     String?
  approvedAt     DateTime?
  completedBy    String?
  completedAt    DateTime?
  rejectedBy     String?
  rejectedAt     DateTime?
  rejectedReason String?
  reference      String? // Transaction reference from payment provider
  notes          String?

  items PayoutRequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@index([supplierId, status])
}

model PayoutRequestItem {
  id              String        @id @default(cuid())
  payoutRequestId String
  payoutRequest   PayoutRequest @relation(fields: [payoutRequestId], references: [id], onDelete: Cascade)

  // A booking can only ever be part of one payout request
  bookingId String @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  // Immutable money snapshots at request time
  grossAmount        Decimal @map("total") @db.Decimal(10, 2)
  platformCommission Decimal @map("commissionAmount") @db.Decimal(10, 2)
  supplierPayout     Decimal @db.Decimal(10, 2)
  currency           String  @default("USD")

  createdAt DateTime @default(now())

  @@index([payoutRequestId])
}

// ── Finance v2: supplier-initiated refund requests ──
// A supplier files a refund request (model named "Dispute" for historical
// reasons) when a customer's money should go back. An open request freezes
// the booking's supplier payout (DISPUTED). Admin approval refunds the
// customer via Stripe and cancels the payout; denial or withdrawal unfreezes
// the funds back to eligible.

model Dispute {
  id            String @id @default(cuid())
  disputeNumber String @unique // Human-readable reference e.g. DS-20260821-XXXX

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  openedById String
  opener     User    @relation("DisputeOpener", fields: [openedById], references: [id])
  supplierId String
  supplier   User    @relation("DisputeSupplier", fields: [supplierId], references: [id])

  reason      String // OPERATIONAL, FORCE_MAJEURE, CUSTOMER_REQUESTED, OTHER
  description String?

  status DisputeStatus @default(OPEN)

  // Resolution
  resolution   String?
  resolvedById String?
  resolvedBy   User?   @relation("DisputeResolver", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  refundAmount Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([supplierId])
  @@index([openedById])
  @@index([status])
}

model Review {
  id String @id @default(cuid())

  // Relationships
  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  tourId     String
  tour       Tour     @relation(fields: [tourId], references: [id])

  // Review Content
  rating  Int // 1-5 stars
  title   String?
  comment String?
  photos  String[] // Review photos

  // Sub-ratings
  valueForMoneyRating Int?
  guideRating         Int?
  meetingRating       Int?

  // Travel metadata
  travelMonth String?
  companions  String[]

  // Moderation
  status      ReviewStatus @default(PENDING)
  moderatedBy String? // Admin user ID
  moderatedAt DateTime?
  flagReason  String?

  // Supplier flagging (review reported by its supplier for admin review)
  flaggedBy   String? // Supplier user ID who flagged the review
  flagComment String? // Supplier's additional detail
  flaggedAt   DateTime?

  // Supplier Response
  supplierResponse   String?
  supplierResponseAt DateTime?

  // Verified Badge
  verified Boolean @default(true) // True = booking ownership verified

  // Helpfulness
  helpfulCount Int @default(0)
  reportCount  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId])
  @@index([tourId])
  @@index([customerId])
  @@index([rating])
  @@index([status])
  @@index([createdAt])
  @@index([tourId, status, rating]) // Tour page: approved reviews sorted by rating
  @@index([status, createdAt]) // Moderation queue
}

model CartItem {
  id String @id @default(cuid())

  // Relationships
  customerId String
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tourId     String
  tour       Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  // Selection Details
  selectedDate DateTime
  selectedTime String?
  travelers    Json // Traveler count and details

  // Pricing (calculated at time of adding to cart)
  subtotal       Decimal @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)
  currency       String  @default("USD")
  discounts      Decimal @default(0) @db.Decimal(10, 2)
  appliedOfferId String?

  // Cart Management
  expiresAt DateTime // Cart items expire after X hours

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, tourId, selectedDate, selectedTime])
  @@index([customerId])
  @@index([expiresAt])
}

// ================================
// CHAT MODELS
// ================================

enum ConversationType {
  SUPPLIER_ADMIN
  SUPPLIER_CUSTOMER
  USER_SUPPORT
  EXPEDITION_CUSTOMER
}

model Conversation {
  id        String           @id @default(cuid())
  type      ConversationType @default(SUPPLIER_ADMIN)
  title     String? // Auto-generated for 1-on-1: other participant's name
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  attachmentUrl  String? // Cloudinary URL
  attachmentType String? // "image" | "document"
  editedAt       DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model Notification {
  id String @id @default(cuid())

  // Relationships
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Notification Content
  type    NotificationType
  title   String
  message String
  data    Json? // Additional structured data

  // Status
  read   Boolean   @default(false)
  readAt DateTime?

  // Delivery
  emailSent   Boolean   @default(false)
  emailSentAt DateTime?
  pushSent    Boolean   @default(false)
  pushSentAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([read])
  @@index([createdAt])
}

model AdminNotification {
  id String @id @default(cuid())

  // Notification Content
  type    AdminNotificationType
  title   String
  message String
  data    Json? // Additional structured data (supplierId, reviewId, payoutId, etc.)

  // Status
  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?
  acknowledgedBy String? // Admin user ID who acknowledged

  createdAt DateTime @default(now())

  @@index([type])
  @@index([acknowledged])
  @@index([createdAt])
}

// ================================
// SYSTEM MODELS
// ================================

model StripeEvent {
  id            String  @id @default(cuid())
  stripeEventId String  @unique
  eventType     String
  processed     Boolean @default(false)
  data          Json

  createdAt DateTime @default(now())

  @@index([stripeEventId])
  @@index([processed])
  @@index([eventType])
}

model SystemConfig {
  id          String  @id @default(cuid())
  key         String  @unique
  value       Json
  description String?

  updatedAt DateTime @updatedAt
  updatedBy String // Admin user ID

  @@index([key])
}

// ================================
// ADMIN SETTINGS — RBAC & CONFIGURATION
// ================================

model AdminPermission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "suppliers.approve", "payouts.view"
  name        String // e.g. "Approve Suppliers"
  description String?
  category    String // e.g. "Suppliers", "Finance", "Reviews"
  isSystem    Boolean @default(false) // cannot be deleted

  roles AdminRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([key])
}

model AdminRole {
  id          String  @id @default(cuid())
  name        String  @unique // e.g. "super_admin", "finance_admin"
  description String?
  isSystem    Boolean @default(false) // super_admin cannot be deleted or modified
  isDefault   Boolean @default(false) // auto-assigned to new admins if not specified

  permissions AdminRolePermission[]
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model AdminRolePermission {
  roleId       String
  permissionId String

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// ================================
// ANALYTICS MODELS
// ================================

model Event {
  id String @id @default(cuid())

  name      String // Dot-notation event name — "booking.completed", "tour.viewed", "search.executed"
  userId    String? // Authenticated user who triggered the event
  sessionId String? // Anonymous session for unauthenticated tracking

  resource   String? // Affected entity type — "Booking", "Tour", "Review", "User"
  resourceId String? // Affected entity ID

  properties Json // Arbitrary event payload (query params, tour IDs, amounts, etc.)
  source     String? // Where the event originated — "web", "mobile", "api", "webhook"

  createdAt DateTime @default(now())

  @@index([name])
  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@index([name, createdAt]) // Coverage for time-series analytics queries
  @@index([userId, name, createdAt]) // Coverage for user-journey / funnel queries
}

// ================================
// TEAM MANAGEMENT
// ================================

model TeamMember {
  id             String    @id @default(cuid())
  supplierId     String
  supplier       User      @relation("SupplierTeam", fields: [supplierId], references: [id], onDelete: Cascade)
  email          String
  role           String    @default("editor")
  status         String    @default("PENDING")
  invitedById    String?
  invitedBy      User?     @relation("TeamInviter", fields: [invitedById], references: [id])
  inviteToken    String?   @unique
  tokenExpiresAt DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([supplierId, email])
  @@index([supplierId])
  @@index([email])
  @@index([inviteToken])
