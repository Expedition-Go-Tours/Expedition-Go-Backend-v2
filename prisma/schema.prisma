  email      String   @unique
  name       String?
  source     String   @default("EXPEDITION")
  subscribed Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email])
  @@index([subscribed])
}

model KeywordRequest {
  id         String               @id @default(cuid())
  keyword    String
  supplierId String
  supplier   User                 @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status     KeywordRequestStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([keyword])
