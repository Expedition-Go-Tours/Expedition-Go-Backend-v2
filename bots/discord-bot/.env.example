# Discord Ops Bot
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_ID=
# Channel where plain-text questions are answered. While this is empty the bot
# never registers a message listener, so every question is silently ignored.
# Get it from Discord: right-click the channel -> Copy Channel ID (with
# Developer Mode on). Example: 1544314075478237184
DISCORD_AI_CHANNEL_ID=

# Incidents webhook — the bot's incident monitor posts rich diagnostics here.
# Same URL as DISCORD_WEBHOOK_INCIDENTS in the app .env (#incidents channel).
DISCORD_WEBHOOK_INCIDENTS=

# Shared secret for calling the backend approval endpoint
DISCORD_APPROVAL_SECRET=

# Runtime
API_URL=http://127.0.0.1:5000
BACKUP_DIR=/var/backups/travio
DATABASE_URL=postgresql://travio:PASSWORD@127.0.0.1:5432/travio

# ── Deterministic business-facts layer ──────────────────────────────────
# Routes common, unambiguous business questions (revenue, bookings, signups,
# tours, suppliers, refunds, disputes, payouts, reviews, customers) to
# hand-written SQL with approved definitions, then hands the result to MiMo for
# narration. Unknown or complex questions still go to the full SQL/ReAct agent.
#
# DEFAULT OFF. Any value other than exactly "true" disables it, so a typo or a
# missing variable can never enable the new path by accident. It is read per
# question from process.env, so flipping it takes effect on the next bot restart
# (pm2 restart), with no code change.
#
# Enabling this changes the numbers the bot reports for some questions, because
# the fact layer applies the reviewed definitions in
# src/core/services/metricDefinitions.js rather than letting the model choose a
# filter. Anything the layer declines — an unknown metric, a currency the data
# does not contain, an analytical question, a failed narration — still falls
# through to the existing SQL agent, so coverage is never reduced.
AI_FACTS_ENABLED=false

# ── Phase 3: shared answer cache ─────────────────────────────────────────
# DEFAULT OFF. When on, a repeat of the same metric (keyed on the route —
# metric, window, filters, top-N — not on the wording) is served from an
# in-process cache for 60 seconds instead of paying for a query and a
# narration call again. SQL is 0.016% of fact-path time; the narration call is
# everything else, so this is where the remaining latency goes.
#
# Two questions that resolve to the same route share one answer, so a second
# operator asking the same thing in another channel costs nothing. Freshness is
# a 60s TTL (the same as the per-user cache in index.js), not invalidation.
AI_FACTS_CACHE_ENABLED=false

# ── Phase 3: reviewed template fallback ──────────────────────────────────
# DEFAULT OFF. When on, a narration call that fails or returns empty is
# answered from a reviewed, deterministic rendering of facts that already
# passed every gate, instead of falling through to the SQL agent.
#
# This does NOT change how any successful answer is written: MiMo narrates
# every routed question, and the template is unreachable while that call
# succeeds. It only changes what happens when the model is down — a reviewed
# rendering of proven numbers, rather than the nondeterministic path that
# answered "revenue for the past month" four different ways.
#
# Kept separate from the cache gate: they are different risks, and an operator
# must be able to disable one without losing the other.
AI_FACTS_TEMPLATE_ENABLED=false
