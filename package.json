    "lint:fix": "eslint . --fix",
    "postinstall": "prisma generate",
    "migrate": "npx prisma migrate deploy",
    "seed": "node prisma/seed.js",
    "seed:perf": "node prisma/seedPerf.js",
    "start": "node server.js",
    "dev": "nodemon server.js"
