NODE_ENV=development
PORT=5000

# PostgreSQL Database — production uses Neon (direct endpoint, NOT pgbouncer)
# DATABASE_URL   = Neon direct connection (remove -pooler from host, remove pgbouncer=true)
# DIRECT_URL     = Same direct URL (used by Prisma for migrations only)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/travio
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/travio

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Client URLs
CLIENT_URL=http://localhost:5173
SUPPLIER_DASHBOARD_URL=http://localhost:5174

# SEO prerender (GET /api/prerender)
# The brand is resolved per request from the storefront's `host` query param
# (www.travioghana.com -> Travio Ghana, expeditiongotours.com -> Expedition-Go
# Tours), so these only shape the FALLBACK brand used when a caller supplies no
# host at all — older edge middleware and direct calls. Leave unset in
# production unless you are deliberately moving that fallback.
SITE_URL=
SITE_NAME=
# Base URL the prerender uses to fetch catalogue data (defaults to this
# process's own API on http://localhost:5000). Brand lives in the path
# (/api/travioghana, /api/expedition), not in this host.
API_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (Orders v2). Server-only — no credential ever reaches the browser.
# PAYPAL_MODE selects sandbox vs live; PAYPAL_ENABLED is the kill switch for
# NEW checkouts (webhooks keep processing either way so in-flight money settles).
PAYPAL_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Comma-separated brand keys allowed to offer PayPal, e.g. ghana,expedition
PAYPAL_BRANDS=

# Google Analytics 4 — Measurement Protocol (server-side purchase/refund events).
# Reports a settled booking / refund to GA4 from the backend, gated on the
# visitor's analytics consent captured at checkout. Leave both unset to disable
# (the reporting service no-ops). Create the API secret in GA Admin →
# Data Streams → your stream → Measurement Protocol API secrets.
GA4_MEASUREMENT_ID=
# A 22-character secret from Admin → Data Streams → (stream) → Measurement
# Protocol API secrets. NOT the numeric data-stream ID: GA answers 204 to that
# and discards the event, which is how a week of revenue went missing.
GA4_API_SECRET=

# Google Analytics 4 — Data API (read side). Only needed for
# `node scripts/ga4-reconcile.js` to diff the database against GA's own
# transaction ledger, and for supplier funnel reports. Create a service account,
# grant it Viewer on the property, then paste its JSON key here (inline) or
# point GA4_SERVICE_ACCOUNT_FILE at the key file.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
GA4_SERVICE_ACCOUNT_FILE=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
# Per-brand From: overrides. Legacy EMAIL_FROM applies to the default
# (TravioAfrica) brand only; unset brands use config/brands.js as the source
# of truth.
EMAIL_FROM_GHANA=
EMAIL_FROM_EXPEDITION=
LOGO_URL=
EMAIL_REPLY_TO=
# Per-brand Reply-To overrides. Legacy EMAIL_REPLY_TO applies to the default
# (TravioAfrica) brand only; unset brands fall back to their own support inbox
# from config/brands.js.
EMAIL_REPLY_TO_GHANA=
EMAIL_REPLY_TO_EXPEDITION=
# Resend webhook secrets (Svix). Both endpoints accept any of these against
# any v1 signature in the header, so dashboard misroutes/rotation don't
# reject valid events.
# RESEND_WEBHOOK_SECRET         — signing secret (whsec_…) of the delivery
#                                 endpoint (/api/email/webhook).
# RESEND_INBOUND_SIGNING_SECRET — signing secret (whsec_…) of the inbound
#                                 endpoint (/api/email/inbound), copied from
#                                 the Resend dashboard. Verify-only.
# RESEND_INBOUND_WEBHOOK_SECRET — HMAC secret for chat reply-address tokens
#                                 (conversation replyToken). Verification
#                                 falls back to it only when
#                                 RESEND_INBOUND_SIGNING_SECRET is unset.
#                                 NEVER change once set — stored replyTokens
#                                 depend on it.
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_SIGNING_SECRET=
RESEND_INBOUND_WEBHOOK_SECRET=

# Redis — production is the Redis container on the Hetzner VPS (redis://redis:6379)
REDIS_URL=redis://localhost:6379

# JWT Secrets (required in production)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Auth cookie scope (optional). Leave unset for host-only cookies: a token
# minted by api.travioghana.com is then sent only back to that API host.
# Setting a parent domain (e.g. .travioghana.com) shares it with every
# subdomain, including Vercel-hosted storefronts — avoid unless required.
AUTH_COOKIE_DOMAIN=

# Sentry
SENTRY_DSN=

# MiMo AI (Xiaomi) — for tour image analysis and content classification
# Get your key at https://api.xiaomimimo.com
MIMO_API_KEY=

# ── Discord bot: deterministic business-facts layer ─────────────────────────
# NOTE: the discord-bot runs under pm2 with cwd = the repo root, so its
# require('dotenv').config() reads THIS file — not bots/discord-bot/.env.
# Setting these in bots/discord-bot/.env alone has no effect on the bot.
#
# All three are DEFAULT OFF, and only the exact string "true" enables them, so
# a typo or a missing variable can only ever disable a path. They are read from
# process.env per question, so flipping one takes effect on the next restart.
#
# AI_FACTS_ENABLED — route common, unambiguous business questions to reviewed
#   SQL definitions + MiMo narration instead of letting the model pick a filter.
#   Everything it declines still falls through to the SQL/ReAct agent.
# AI_FACTS_CACHE_ENABLED — Phase 3. Serve a repeat of the same metric from a
#   60s in-process cache instead of re-querying and re-narrating. Keyed on the
#   route (metric, window, filters, top-N), not on the wording of the question.
# AI_FACTS_TEMPLATE_ENABLED — Phase 3. When the narration call fails, answer
#   from a reviewed rendering of already-validated facts rather than falling
#   through to the SQL agent. Never used while the model answers normally.
AI_FACTS_ENABLED=false
AI_FACTS_CACHE_ENABLED=false
AI_FACTS_TEMPLATE_ENABLED=false

# Allowed Origins (comma-separated)
ALLOWED_ORIGINS=

# Customer storefront bases used by chat-notification emails. Defaults are the
# canonical domains; override only if a storefront moves.
# GHANA_STOREFRONT_URL=https://www.travioghana.com
# AFRICA_STOREFRONT_URL=https://travioafrica.com
# EXPEDITION_STOREFRONT_URL=https://www.expeditiongotours.com

# Rate limiting (optional — defaults used if not set)
# RATELIMIT_GLOBAL_MAX=500
# RATELIMIT_GLOBAL_WINDOW_MS=3600000
# RATELIMIT_AUTH_MAX=20
# RATELIMIT_AUTH_WINDOW_MS=900000
# RATELIMIT_UPLOAD_MAX=20
# RATELIMIT_UPLOAD_WINDOW_MS=3600000
# RATELIMIT_CONTACT_MAX=5
# RATELIMIT_CONTACT_WINDOW_MS=900000
# RATELIMIT_SUBSCRIBE_MAX=10
# RATELIMIT_SUBSCRIBE_WINDOW_MS=60000
# RATELIMIT_ADMIN_MAX=200
# RATELIMIT_ADMIN_WINDOW_MS=900000
# RATELIMIT_LOCATION_MAX=120
# RATELIMIT_LOCATION_WINDOW_MS=60000
# RATELIMIT_TEAM_INVITE_MAX=10
# RATELIMIT_TEAM_INVITE_WINDOW_MS=3600000
# RATELIMIT_INVITE_LOOKUP_MAX=30
# RATELIMIT_INVITE_LOOKUP_WINDOW_MS=900000

# Logtail (optional)
LOGTAIL_TOKEN=

# Discord Ops Hub webhooks (optional — feature is disabled when unset)
DISCORD_WEBHOOK_DEPLOYS=
DISCORD_WEBHOOK_INCIDENTS=
DISCORD_WEBHOOK_SALES=
DISCORD_WEBHOOK_VERIFICATION=
DISCORD_WEBHOOK_DIGEST=
DISCORD_WEBHOOK_APPROVALS=
# Outside-in availability alerts (external uptime monitor posts here directly)
DISCORD_WEBHOOK_UPTIME_EXTERNAL=

# Discord approvals (optional — disabled when unset)
DISCORD_APPROVAL_SECRET=
DISCORD_APPROVAL_ADMIN_ID=

# Admin dashboard URL (used for the "Review" link in Discord supplier notifications)
ADMIN_DASHBOARD_URL=
