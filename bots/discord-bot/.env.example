# Discord Ops Bot
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_ID=
# Channel where plain-text questions are answered. While this is empty the bot
# never registers a message listener, so every question is silently ignored.
# Get it from Discord: right-click the channel -> Copy Channel ID (with
# Developer Mode on). Example: 1544314075478237184
DISCORD_AI_CHANNEL_ID=

# Incidents webhook — the bot's incident monitor posts rich diagnostics here.
# Same URL as DISCORD_WEBHOOK_INCIDENTS in the app .env (#incidents channel).
DISCORD_WEBHOOK_INCIDENTS=

# Shared secret for calling the backend approval endpoint
DISCORD_APPROVAL_SECRET=

# Runtime
API_URL=http://127.0.0.1:5000
BACKUP_DIR=/var/backups/travio
DATABASE_URL=postgresql://travio:PASSWORD@127.0.0.1:5432/travio

# ── Deterministic business-facts layer ──────────────────────────────────
# Routes common, unambiguous business questions (revenue, bookings, signups,
# tours, suppliers, refunds, disputes, payouts, reviews, customers) to
# hand-written SQL with approved definitions, then hands the result to MiMo for
# narration. Unknown or complex questions still go to the full SQL/ReAct agent.
#
# DEFAULT OFF. Any value other than exactly "true" disables it, so a typo or a
# missing variable can never enable the new path by accident. Read per question
# in queryAgent.answerQuestion; no restart-free hot reload is needed beyond the
# process reading the env.
#
# Enabling this changes the numbers the bot reports for some questions, because
# the fact layer applies the reviewed definitions in
# src/core/services/metricDefinitions.js rather than letting the model choose a
# filter. Anything the layer declines — an unknown metric, a currency the data
# does not contain, an analytical question, a failed narration — still falls
# through to the existing SQL agent, so coverage is never reduced.
AI_FACTS_ENABLED=false
