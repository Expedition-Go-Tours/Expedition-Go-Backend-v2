model ArticleTour {
  articleId String
  tourId    String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tour      Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@id([articleId, tourId])
  @@index([articleId])
  @@index([tourId])
}

model AuditLog {
  id String @id @default(cuid())

  // Actor
  userId    String?
  userEmail String?
  ipAddress String?
  userAgent String?

  // Action
  action     String // e.g., "user.created", "booking.cancelled"
  resource   String // e.g., "User", "Booking"
  resourceId String?

  // Details
  oldValues Json?
  newValues Json?
  metadata  Json?

  // Tamper evidence (hash chain)
  prevHash String?
  hash     String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@index([hash])
}

model AuditLogArchive {
  id String @id @default(cuid())

  // Actor
  userId    String?
  userEmail String?
  ipAddress String?
  userAgent String?

  // Action
  action     String
  resource   String
  resourceId String?

  // Details
  oldValues Json?
  newValues Json?
  metadata  Json?

  // Tamper evidence (hash chain)
  prevHash String?
  hash     String?

  createdAt  DateTime
  archivedAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([archivedAt])
  @@index([createdAt])
}

model BookingCounter {
