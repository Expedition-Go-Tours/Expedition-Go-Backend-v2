  "scripts": {
    "test": "jest --testPathIgnorePatterns __tests__/performance/ --testPathIgnorePatterns __tests__/concurrency/ --testPathIgnorePatterns __tests__/e2e/",
    "test:ci": "jest --testPathIgnorePatterns __tests__/performance/ --testPathIgnorePatterns __tests__/concurrency/ --testPathIgnorePatterns __tests__/e2e/ --forceExit",
