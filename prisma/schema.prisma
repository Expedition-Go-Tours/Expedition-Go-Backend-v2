// ================================
// EXPEDITION GO TOUR — CURATED LISTINGS
// ================================

model ExpeditionTour {
  id     String @id @default(cuid())
  tourId String @unique
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  // Listing state
  isActive    Boolean     @default(false)
  bookingFlow BookingFlow @default(DIRECT)
  externalUrl String?

  // Display
  displayOrder Int     @default(0)
  isFeatured   Boolean @default(false)

  // Audit — publish
  publishedById String?
  publishedBy   User?     @relation("ExpeditionPublishedBy", fields: [publishedById], references: [id])
  publishedAt   DateTime?

  // Audit — unpublish
  unpublishedById String?
  unpublishedBy   User?     @relation("ExpeditionUnpublishedBy", fields: [unpublishedById], references: [id])
  unpublishedAt   DateTime?
  unpublishReason String?

  // Sync tracking
  syncStatus String? // synced | pending | failed
  lastSyncAt DateTime?
  syncError  String?

  // Legacy adder tracker
  addedById String?
  addedBy   User?   @relation(fields: [addedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@index([isActive, isFeatured, displayOrder])
}

// ================================
// BLOG / CMS MODELS
// ================================

model Article {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String        @db.Text
  body            Json // Portable Text (structured JSON from Sanity)
  featuredImage   String?
  images          Json?
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  publishedAt     DateTime?
  status          ArticleStatus @default(DRAFT)
  readTime        Int?
  locale          String        @default("en")
  viewCount       Int           @default(0)
  shareCount      Int           @default(0)

  authorId     String
  author       User                  @relation(fields: [authorId], references: [id])
  categoryId   String?
  category     ArticleCategory?      @relation(fields: [categoryId], references: [id])
  tags         ArticleTagOnArticle[]
  relatedTours ArticleTour[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([locale])
  @@index([authorId])
  @@index([categoryId])
  @@index([status, publishedAt])
  @@index([locale, status, publishedAt])
}

model ArticleCategory {
  id          String            @id @default(cuid())
