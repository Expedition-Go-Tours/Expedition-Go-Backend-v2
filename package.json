    "test:perf:listing": "k6 run __tests__/performance/k6/scenarios/tourListing.js",
    "test:perf:checkout": "k6 run __tests__/performance/k6/scenarios/checkoutFlow.js",
    "test:perf:mixed": "k6 run __tests__/performance/k6/scenarios/mixed.js",
