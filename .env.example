NODE_ENV=development
PORT=5000

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/travio
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/travio

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Client URLs
CLIENT_URL=http://localhost:5173
SUPPLIER_DASHBOARD_URL=http://localhost:5174

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (SendGrid)
SENDGRID_API_KEY=
EMAIL_FROM=
LOGO_URL=
EMAIL_REPLY_TO=

# Redis
REDIS_URL=redis://localhost:6379

# Sentry
SENTRY_DSN=

# Allowed Origins (comma-separated)
ALLOWED_ORIGINS=

# Logtail (optional)
LOGTAIL_TOKEN=
